# Wzór pliku .env — skopiuj do .env i uzupełnij. Opis każdej zmiennej: app/config.py.
# Brak klucza danej usługi wyłącza tylko tę funkcję.

# Bazy Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SAAS_TURSO_DATABASE_URL=
SAAS_TURSO_AUTH_TOKEN=
ENCRYPTION_KEY=

# Panel (Next.js)
PANEL_URL=
INTERNAL_API_SECRET=
PANEL_API_URL=http://localhost:3000
# ADMIN_PANEL_API_URL=        # domyślnie = PANEL_API_URL
PANEL_SLUG=

# Modele AI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=cedar
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_SHARED_SECRET=
DEEPGRAM_API_KEY=
# DEEPGRAM_BASE_URL=          # domyślnie api.deepgram.com

# Operatorzy
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=

# Powiadomienia i integracje
RESEND_API_KEY=
VAPID_PRIVATE_KEY=
# N8N_CRM_WEBHOOK_URL=        # domyślnie webhook produkcyjny n8n

# Zapasowy TTS
CARTESIA_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Testy na żywo
TEST_TENANT_ID=
# ENABLE_API_DOCS=1            # /docs i /openapi.json lokalnie
